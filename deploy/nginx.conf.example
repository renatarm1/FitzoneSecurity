# Configuración de referencia para Nginx en un VPS de Hostinger.
# Copiar a /etc/nginx/sites-available/fitzone, ajustar dominio/rutas, y luego:
#   sudo ln -s /etc/nginx/sites-available/fitzone /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#
# Nota: /static/ ya lo puede servir Gunicorn+WhiteNoise directamente (ver settings.py),
# así que este bloque es opcional; sirve para que Nginx cachee esos archivos sin
# tocar el proceso de Python en cada request.

server {
    listen 80;
    server_name tudominio.com www.tudominio.com;

    location /static/ {
        alias /var/www/fitzone/staticfiles/;
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    location / {
        proxy_pass http://unix:/run/fitzone.sock;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# Una vez que tengas el certificado SSL (Hostinger ofrece Let's Encrypt gratis desde hPanel
# o via certbot), agrega el bloque HTTPS y redirige el de arriba con:
#   return 301 https://$host$request_uri;
