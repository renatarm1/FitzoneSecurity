# Copiar este archivo a ".env" en el servidor y completar con valores reales.
# ".env" nunca se sube a git (ver .gitignore) — cada entorno (local/producción) tiene el suyo.

# Clave de Google reCAPTCHA v2 (la "secret key", no la site key)
RECAPTCHA_SECRET_KEY=

# Generar una nueva y única para producción, por ejemplo con:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# Ruta del panel de administración (no dejar "admin/" en producción; usar algo impredecible)
ADMIN_URL=admin-CAMBIAR-ESTO/

# En producción SIEMPRE en False
DJANGO_DEBUG=False

# Dominio(s) reales separados por coma, sin protocolo (ej: midominio.com,www.midominio.com)
ALLOWED_HOSTS=midominio.com,www.midominio.com

# Orígenes permitidos para CORS. Si el frontend se sirve desde el mismo dominio que la API
# (recomendado, ver DEPLOYMENT.md) esto no se usa realmente, pero déjalo consistente.
CORS_ALLOWED_ORIGINS=https://midominio.com

# En producción, una vez tengas SSL activo (Hostinger da Let's Encrypt gratis): True
SECURE_SSL_REDIRECT=True

# Igual: solo activar (ej. 31536000 = 1 año) después de confirmar que HTTPS funciona estable.
# En 0 significa "desactivado".
SECURE_HSTS_SECONDS=0

# Avanzado/opcional, casi irreversible una vez que los navegadores lo memorizan.
# Déjalos en False salvo que sepas exactamente lo que hacen.
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
